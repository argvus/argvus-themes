# Maintainer: William C. Canin
pkgname=argvus-themes
pkgver=0.0.0
pkgrel=1
pkgdesc="All official ARGVUS themes"
arch=('any')
url="https://github.com/argvus/argvus-themes"
license=('GPL-3.0-only')
depends=(
  'argvus-theme-catppuccin-latte' 'argvus-theme-dracula' 'argvus-theme-everforest-light'
  'argvus-theme-github-light' 'argvus-theme-gruvbox-dark' 'argvus-theme-gruvbox-high-dark'
  'argvus-theme-gruvbox-light' 'argvus-theme-lady-mist' 'argvus-theme-matrix'
  'argvus-theme-monokai-dark' 'argvus-theme-nord-light' 'argvus-theme-obsidian-light'
  'argvus-theme-one-dark' 'argvus-theme-one-light' 'argvus-theme-rose-pine'
  'argvus-theme-silver-dark' 'argvus-theme-slate-dark' 'argvus-theme-solarized-light'
  'argvus-theme-solitude' 'argvus-theme-sunset' 'argvus-theme-tokyo-night'
  'argvus-theme-universe' 'argvus-theme-watercolor-light'
)
options=('!debug')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

package() {
  install -Dm644 "${srcdir}/${pkgname}-${pkgver}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
